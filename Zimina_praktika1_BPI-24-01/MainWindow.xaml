<Window x:Class="Zimina_praktika1_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zimina_praktika1_BPI_24_01"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="1000"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
            <Label Content="Последние документы"/>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Открыть" Height="20" Margin="5"/>
            <Button Content="Сохранить" Height="20" Margin="5"/>
            <Button Content="Закрыть" Height="20" Margin="5"/>
            <Button Content="Обработать" Height="20" Margin="5"/>
            <Button Content="О программе" Height="20" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.RowSpan="2">
            <Label Content="1.txt"/>
            <Label Content="2.txt"/>
            <Label Content="3.txt"/>
            <Label Content="4.txt"/>
            <Label Content="5.txt"/>
            <Label Content="6.txt"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Label Content="1.txt" FontWeight="Black"/>
            <Label Content="2.txt"/>
            <Label Content="3.txt"/>
        </StackPanel>

        <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Width="80" Height="80" Content="A" BorderThickness="0" Background="Yellow"/>
            <Button Width="80" Height="80" Content="B" Margin="5" BorderThickness="0" Background="Red"/>
            <Button Width="80" Height="80" Content="C" Margin="5" BorderThickness="0" Background="Green"/>
            <Button Width="80" Height="80" Content="D" Margin="5" BorderThickness="0" Background="Blue"/>
            <Button Width="80" Height="80" Content="E" Margin="5" BorderThickness="0" Background="Gray"/>
            <Button Width="80" Height="80" Content="F" Margin="5" BorderThickness="0" Background="Aqua"/>
        </WrapPanel>
    </Grid>
</Window>
